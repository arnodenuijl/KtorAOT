{
    "realm": "demo",
    "enabled": true,
    "sslRequired": "none",
    "accessTokenLifespan": 3600,
    "otpPolicyType": "totp",
    "otpPolicyAlgorithm": "HmacSHA256",
    "otpPolicyDigits": 6,
    "otpPolicyLookAheadWindow": 1,
    "otpPolicyPeriod": 30,
    "clients": [
        {
            "webOrigins": [
                "http://localhost:8000"
            ],
            "clientId": "kong-client",
            "clientAuthenticatorType": "client-secret",
            "secret": "kong-client-secret",
            "publicClient": false,
            "directAccessGrantsEnabled": false,
            "standardFlowEnabled": true,
            "redirectUris": [
                "http://localhost:8000/personApi"
            ],
            "enabled": true
        }
    ],
    "users": [
        {
            "emailVerified": true,
            "credentials": [
                {
                    "value": "password",
                    "type": "password",
                    "temporary": false
                }
            ],
            "lastName": "User",
            "username": "testuser",
            "email": "testuser@example.com",
            "firstName": "Test",
            "requiredActions": [
                "CONFIGURE_TOTP"
            ],
            "enabled": true
        }
    ],
    "components": {
        "org.keycloak.keys.KeyProvider": [
            {
                "config": {
                    "privateKey": [
                        ""
                    ],
                    "certificate": [
                        ""
                    ],
                    "active": [
                        "true"
                    ],
                    "priority": [
                        "1000"
                    ],
                    "algorithm": [
                        "RS256"
                    ],
                    "enabled": [
                        "true"
                    ]
                },
                "name": "fixed-rsa",
                "providerId": "rsa"
            }
        ]
    }
}